# Demo user (must match the seeded profile in supabase/migrations)
DEMO_USER_ID=00000000-0000-4000-8000-000000000001

# Supabase (publishable key from the dashboard; ANON_KEY still works as a fallback)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed for n8n/mock to insert recipes past RLS.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Default points at the local mock. Swap for the real n8n webhook when ready.
N8N_WEBHOOK_URL=http://localhost:3000/api/mock-n8n
N8N_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
